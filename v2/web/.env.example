# Staging only. Never use a service-role key here.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Exact HTTPS origin of the staging web deployment, no trailing slash.
APP_ORIGIN=https://staging.example.invalid

# Never enable before staging database safeguards and concurrency tests pass.
STAGING_BOOKING_WRITES=disabled

# Admin writes disabled until isolated authorized and unauthorized tests pass.
STAGING_ADMIN_WRITES=disabled

# Schedule, visits, home-care and renewals require separate end-to-end validation.
STAGING_SERVICE_WRITES=disabled

STAGING_NOTIFICATION_WRITES=disabled

# Signup requires verified email delivery, anti-abuse controls and privacy/consent review.
STAGING_REGISTRATION_WRITES=disabled
